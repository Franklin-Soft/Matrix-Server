#!$PREFIX/bin/bash
# ================================================================
# MATRIX SERVER - setup
# https://github.com/Franklin-Soft/Matrix-Server
# ================================================================

# --- Colores ---
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${BLUE}=== Matrix Server - Instalacion ===${NC}"

# --- Permiso de almacenamiento ---
if [ ! -d ~/storage ]; then
    echo "Solicitando permiso de almacenamiento..."
    termux-setup-storage
    sleep 5
fi

# --- Instalar paquetes base ---
echo -e "${BLUE}Instalando Apache, PHP, PHP-FPM y Sodium...${NC}"
pkg install php-apache php-fpm php-sodium openssl-tool -y

# ================================================================
# Ajustar www.conf de PHP-FPM para Termux
# ================================================================
WWW_CONF="$PREFIX/etc/php-fpm.d/www.conf"

if [ -f "$WWW_CONF" ]; then
    echo "Ajustando www.conf para Termux..."

    # Comentar user/group: FPM no corre como root, estas directivas no aplican
    sed -i 's/^user = /;user = /' "$WWW_CONF"
    sed -i 's/^group = /;group = /' "$WWW_CONF"

    # Fijar el socket en una ruta estable
    sed -i "s|^listen = .*|listen = $PREFIX/var/run/php-fpm.sock|" "$WWW_CONF"
    sed -i "s|^;listen = .*|listen = $PREFIX/var/run/php-fpm.sock|" "$WWW_CONF"

    # Fijar el log de errores en un sitio conocido
    sed -i "s|^;error_log = .*|error_log = $PREFIX/var/log/php-fpm.log|" "$WWW_CONF"
    sed -i "s|^error_log = .*|error_log = $PREFIX/var/log/php-fpm.log|" "$WWW_CONF"

    echo "www.conf ajustado."
fi

# --- Copiar httpd.conf ---
echo "Copiando httpd.conf..."
rm -f $PREFIX/etc/apache2/httpd.conf
cp httpd.conf $PREFIX/etc/apache2/

# --- Copiar httpd-ssl.conf ---
echo "Copiando httpd-ssl.conf..."
rm -f $PREFIX/etc/apache2/extra/httpd-ssl.conf
cp httpd-ssl.conf $PREFIX/etc/apache2/extra/

# --- Copiar php.ini ---
echo "Copiando php.ini..."
mkdir -p $PREFIX/etc/php
cp -f php.ini $PREFIX/etc/php/php.ini

# --- Generar certificado SSL autofirmado ---
echo "Generando certificado SSL autofirmado..."
openssl req \
    -x509 \
    -newkey rsa:2048 \
    -keyout server.key \
    -out server.crt \
    -days 365 \
    -nodes \
    -subj '/CN=localhost'

mv -f server.crt $PREFIX/etc/apache2/
mv -f server.key $PREFIX/etc/apache2/

# --- Instalar el comando matrix ---
echo "Instalando comando matrix..."
rm -f $PREFIX/bin/matrix
chmod +x matrix
cp matrix $PREFIX/bin/

# --- Instalar MariaDB y Composer ---
echo -e "${BLUE}Instalando MariaDB y Composer...${NC}"
pkg install mariadb composer -y

# --- Crear directorio de documentos ---
mkdir -p /sdcard/htdocs
cp -n .htaccess /sdcard/htdocs/

# --- Crear phpinfo ---
php_info='/sdcard/htdocs/phpinfo'
if [ ! -d "$php_info" ]; then
    mkdir "$php_info"
    echo "<?php phpinfo(); ?>" > "$php_info/index.php"
fi

# --- Instalar phpMyAdmin ---
if [ ! -d /sdcard/htdocs/phpmyadmin ]; then
    echo -e "${BLUE}Instalando phpMyAdmin...${NC}"
    cd /sdcard/htdocs
    composer create-project phpmyadmin/phpmyadmin
fi

cd ~/matrix
cp -f config.inc.php /sdcard/htdocs/phpmyadmin/config.inc.php

# ================================================================
# Deteccion dinamica del socket de MariaDB
# ================================================================
echo -e "${BLUE}Detectando socket de MariaDB...${NC}"

# Arrancar MariaDB por primera vez si no esta corriendo
if ! pgrep -x mariadbd > /dev/null; then
    mariadbd-safe &
    sleep 5
fi

SOCK_PATH=$(mariadb -u root -N -B -e "SELECT @@socket;" 2>/dev/null)

if [ -z "$SOCK_PATH" ]; then
    for candidate in \
        "$PREFIX/var/run/mysqld.sock" \
        "$PREFIX/var/run/mysqld/mysqld.sock" \
        "$PREFIX/tmp/mysql.sock" \
        "/tmp/mysql.sock"
    do
        if [ -S "$candidate" ]; then
            SOCK_PATH="$candidate"
            break
        fi
    done
fi

if [ -z "$SOCK_PATH" ]; then
    SOCK_PATH=$(find "$PREFIX" -name '*.sock' \( -path '*mysql*' -o -path '*maria*' \) 2>/dev/null | head -n1)
fi

if [ -z "$SOCK_PATH" ]; then
    echo -e "${YELLOW}Aviso: no se pudo detectar el socket, usando valor por defecto.${NC}"
    SOCK_PATH="$PREFIX/var/run/mysqld.sock"
fi

echo -e "${GREEN}Socket detectado: $SOCK_PATH${NC}"

# --- Escribir configuracion del socket para PHP ---
mkdir -p $PREFIX/etc/php/conf.d
cat > $PREFIX/etc/php/conf.d/99-mysql-socket.ini <<EOF
mysqli.default_socket = $SOCK_PATH
pdo_mysql.default_socket = $SOCK_PATH
EOF

# --- Escribir configuracion de MariaDB ---
mkdir -p $PREFIX/etc/mysql
cat > $PREFIX/etc/mysql/my.cnf <<EOF
[client]
port=3306
socket=$SOCK_PATH

[mysqld]
port=3306
socket=$SOCK_PATH
datadir=$PREFIX/var/lib/mysql

[mysqldump]
quick
max_allowed_packet=512M
EOF

# ================================================================
# Verificacion final
# ================================================================
echo -e "${BLUE}Verificando instalacion...${NC}"

php -r '
$m = @new mysqli("localhost", "root", "");
if ($m->connect_error) {
    echo "MariaDB: FAIL - " . $m->connect_error . "\n";
} else {
    echo "MariaDB: OK - " . $m->server_info . "\n";
}
'

# Detener MariaDB para dejar que matrix lo arranque luego
pkill -x mariadbd 2>/dev/null
pkill -x mariadbd-safe 2>/dev/null

echo
echo -e "${GREEN}Matrix Server se ha instalado correctamente.${NC}"
echo "/sdcard/htdocs - es tu directorio de documentos."
echo "Coloca tus archivos en /sdcard/htdocs"
echo -e "Ejecuta: ${YELLOW}matrix start${NC}"

# matrix-setup