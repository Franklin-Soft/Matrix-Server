#!$PREFIX/bin/bash
# ================================================================
# MATRIX SERVER - update
# https://github.com/Franklin-Soft/Matrix-Server
# ================================================================

BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${BLUE}Actualizando Matrix Server...${NC}"

# --- Detener servicios ---
apachectl stop 2>/dev/null

pgrep -f "php-fpm" > /dev/null && pkill -f "php-fpm"

pgrep -f "mariadbd-safe" > /dev/null && pkill -f "mariadbd-safe"
pgrep -f "bin/mariadbd" > /dev/null && pkill -f "bin/mariadbd"

sleep 1

# --- Reinstalar dependencias clave ---
echo -e "${BLUE}Verificando dependencias...${NC}"
pkg install php-fpm php-sodium -y

# --- Reajustar www.conf de PHP-FPM ---
WWW_CONF="$PREFIX/etc/php-fpm.d/www.conf"

if [ -f "$WWW_CONF" ]; then
    echo "Reajustando www.conf para Termux..."
    sed -i 's/^user = /;user = /' "$WWW_CONF"
    sed -i 's/^group = /;group = /' "$WWW_CONF"
fi

# --- Actualizar httpd.conf ---
echo "Actualizando httpd.conf..."
rm -f $PREFIX/etc/apache2/httpd.conf
cp httpd.conf $PREFIX/etc/apache2/

# --- Actualizar httpd-ssl.conf ---
echo "Actualizando httpd-ssl.conf..."
rm -f $PREFIX/etc/apache2/extra/httpd-ssl.conf
cp httpd-ssl.conf $PREFIX/etc/apache2/extra/

# --- Asegurar directorio de VirtualHosts ---
mkdir -p $PREFIX/etc/apache2/extra/matrix-vhosts

# --- Actualizar php.ini ---
echo "Actualizando php.ini..."
mkdir -p $PREFIX/etc/php
cp -f php.ini $PREFIX/etc/php/php.ini

# --- Actualizar comando matrix ---
echo "Actualizando comando matrix..."
rm -f $PREFIX/bin/matrix
chmod +x matrix
cp matrix $PREFIX/bin/

# --- Actualizar .htaccess, index.php y config ---
cp -n .htaccess /sdcard/htdocs/
cp -n index.php /sdcard/htdocs/
cp -n config.inc.php /sdcard/htdocs/phpmyadmin/config.inc.php

# --- Asegurar archivo .virtual-host ---
if [ ! -f /sdcard/htdocs/.virtual-host ]; then
    echo "127.0.0.1 .go" > /sdcard/htdocs/.virtual-host
fi

# ================================================================
# Deteccion y regeneracion del socket de MariaDB
# ================================================================
echo -e "${BLUE}Actualizando configuracion de MariaDB...${NC}"

if ! pgrep -f "bin/mariadbd" > /dev/null; then
    mariadbd-safe &
    sleep 5
fi

SOCK_PATH=$(mariadb -u root -N -B -e "SELECT @@socket;" 2>/dev/null)

if [ -z "$SOCK_PATH" ]; then
    for candidate in \
        "$PREFIX/var/run/mysqld.sock" \
        "$PREFIX/var/run/mysqld/mysqld.sock" \
        "$PREFIX/tmp/mysql.sock" \
        "/tmp/mysql.sock"
    do
        if [ -S "$candidate" ]; then
            SOCK_PATH="$candidate"
            break
        fi
    done
fi

if [ -z "$SOCK_PATH" ]; then
    SOCK_PATH=$(find "$PREFIX" -name '*.sock' \( -path '*mysql*' -o -path '*maria*' \) 2>/dev/null | head -n1)
fi

if [ -z "$SOCK_PATH" ]; then
    SOCK_PATH="$PREFIX/var/run/mysqld.sock"
fi

echo -e "${GREEN}Socket detectado: $SOCK_PATH${NC}"

mkdir -p $PREFIX/etc/php/conf.d
cat > $PREFIX/etc/php/conf.d/99-mysql-socket.ini <<EOF
mysqli.default_socket = $SOCK_PATH
pdo_mysql.default_socket = $SOCK_PATH
EOF

mkdir -p $PREFIX/etc/mysql
cat > $PREFIX/etc/mysql/my.cnf <<EOF
[client]
port=3306
socket=$SOCK_PATH

[mysqld]
port=3306
socket=$SOCK_PATH
datadir=$PREFIX/var/lib/m
