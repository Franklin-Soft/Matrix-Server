#!/data/data/com.termux/files/usr/bin/bash
# ================================================================
# MATRIX SERVER - matrix
# https://github.com/Franklin-Soft/Matrix-Server
# ================================================================

if [ ! -d /sdcard/htdocs ]; then
    mkdir /sdcard/htdocs
fi

ACMD="$1"

# --- Colores ---
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- Rutas fijas ---
VHOST_DIR="$PREFIX/etc/apache2/extra/matrix-vhosts"
VHOST_LIFE_FILE="/sdcard/htdocs/.virtual-host"
FPM_SOCK="/data/data/com.termux/files/usr/var/run/php-fpm.sock"

# --- Exclusiones de VirtualHosts ---
EXCLUDE_NAMES="phpmyadmin phpinfo"

# ================================================================
# Deteccion dinamica del socket de MariaDB
# ================================================================
detect_mysql_socket() {
    SOCK=$(mariadb -u root -N -B -e "SELECT @@socket;" 2>/dev/null)
    if [ -n "$SOCK" ]; then
        echo "$SOCK"
        return 0
    fi

    for candidate in \
        "$PREFIX/var/run/mysqld.sock" \
        "$PREFIX/var/run/mysqld/mysqld.sock" \
        "$PREFIX/tmp/mysql.sock" \
        "/tmp/mysql.sock"
    do
        if [ -S "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    FOUND=$(find "$PREFIX" -name '*.sock' \( -path '*mysql*' -o -path '*maria*' \) 2>/dev/null | head -n1)
    if [ -n "$FOUND" ]; then
        echo "$FOUND"
        return 0
    fi

    return 1
}

# ================================================================
# Autorreparar la configuracion del socket
# ================================================================
ensure_mysql_socket_config() {
    SOCK_PATH=$(detect_mysql_socket)
    if [ -z "$SOCK_PATH" ]; then
        SOCK_PATH="$PREFIX/var/run/mysqld.sock"
    fi

    mkdir -p $PREFIX/etc/php/conf.d
    cat > $PREFIX/etc/php/conf.d/99-mysql-socket.ini <<EOF
mysqli.default_socket = $SOCK_PATH
pdo_mysql.default_socket = $SOCK_PATH
EOF
}

# ================================================================
# Dominios virtuales .go
# ================================================================

add_virtualhost_life() {
    if [ ! -f "$VHOST_LIFE_FILE" ]; then
        echo "Creando archivo de dominios virtuales..."
        echo "127.0.0.1 .go" > "$VHOST_LIFE_FILE"
        echo -e "${GREEN}Archivo creado: $VHOST_LIFE_FILE${NC}"
        echo ""
        echo -e "${YELLOW}IMPORTANTE:${NC}"
        echo "1. Abre la app Virtual Hosts en tu telefono"
        echo "2. Importa el archivo $VHOST_LIFE_FILE"
        echo "3. Activa Virtual Hosts (boton verde)"
        echo ""
        echo "Con eso, cualquier carpeta en /sdcard/htdocs/ sera accesible como:"
        echo "  http://nombrecarpeta.go"
        echo ""
    fi
}

is_excluded() {
    local name="$1"
    for ex in $EXCLUDE_NAMES; do
        [ "$name" = "$ex" ] && return 0
    done
    return 1
}

generate_apache_vhosts() {
    echo "Escaneando proyectos en /sdcard/htdocs/..."

    mkdir -p "$VHOST_DIR"

    rm -f "$VHOST_DIR"/*.conf

    COUNT=0

    CERT_FILE="$PREFIX/etc/apache2/server.crt"
    KEY_FILE="$PREFIX/etc/apache2/server.key"

    for dir in /sdcard/htdocs/*/; do
        [ -d "$dir" ] || continue

        NAME=$(basename "$dir")

        case "$NAME" in
            .*) continue ;;
        esac

        if is_excluded "$NAME"; then
            continue
        fi

        SAFE_NAME=$(echo "$NAME" | tr -cd 'a-zA-Z0-9_-')
        [ -z "$SAFE_NAME" ] && continue

        CONF_FILE="$VHOST_DIR/$SAFE_NAME.conf"

        cat > "$CONF_FILE" <<EOF
# =====================================================
# Proyecto: $NAME
# Ruta:     $dir
# Generado automaticamente por Matrix Server
# =====================================================

<VirtualHost *:80>
    ServerName $SAFE_NAME.go
    DocumentRoot "$dir"
    <Directory "$dir">
        AllowOverride All
        Require all granted
        Options Indexes FollowSymLinks
    </Directory>
    ErrorLog  "$PREFIX/var/log/apache2/$SAFE_NAME.error.log"
    CustomLog "$PREFIX/var/log/apache2/$SAFE_NAME.access.log" common
</VirtualHost>

<VirtualHost *:443>
    ServerName $SAFE_NAME.go
    DocumentRoot "$dir"
    <Directory "$dir">
        AllowOverride All
        Require all granted
        Options Indexes FollowSymLinks
    </Directory>

    SSLEngine on
    SSLCertificateFile    "$CERT_FILE"
    SSLCertificateKeyFile "$KEY_FILE"

    ErrorLog  "$PREFIX/var/log/apache2/$SAFE_NAME-ssl.error.log"
    CustomLog "$PREFIX/var/log/apache2/$SAFE_NAME-ssl.access.log" common
</VirtualHost>
EOF

        COUNT=$((COUNT + 1))
    done

    echo -e "${GREEN}$COUNT proyectos detectados.${NC}"

    if [ "$COUNT" -gt 0 ]; then
        echo "Dominios disponibles:"
        for dir in /sdcard/htdocs/*/; do
            [ -d "$dir" ] || continue
            NAME=$(basename "$dir")
            case "$NAME" in
                .*) continue ;;
            esac
            if is_excluded "$NAME"; then
                continue
            fi
            SAFE_NAME=$(echo "$NAME" | tr -cd 'a-zA-Z0-9_-')
            [ -z "$SAFE_NAME" ] && continue
            echo "  http://$SAFE_NAME.go"
            echo "  https://$SAFE_NAME.go"
        done
    fi
}

# ================================================================
# Ajustar www.conf de PHP-FPM para Termux
# ================================================================
fix_fpm_config() {
    WWW_CONF="$PREFIX/etc/php-fpm.d/www.conf"

    if [ ! -f "$WWW_CONF" ]; then
        return 0
    fi

    if grep -q '^user = ' "$WWW_CONF" || grep -q '^group = ' "$WWW_CONF"; then
        sed -i 's/^user = /;user = /' "$WWW_CONF"
        sed -i 's/^group = /;group = /' "$WWW_CONF"
        echo "www.conf ajustado para Termux (user/group ignorados)."
    fi
}

# ================================================================
# Deteccion de procesos
# ================================================================
is_apache_running() {
    pgrep -f "bin/httpd" > /dev/null
}

is_mariadb_running() {
    pgrep -f "bin/mariadbd" > /dev/null
}

is_mariadb_safe_running() {
    pgrep -f "mariadbd-safe" > /dev/null
}

is_fpm_running() {
    pgrep -f "php-fpm" > /dev/null
}

# ================================================================
# PHP-FPM
# ================================================================
start_fpm() {
    fix_fpm_config

    if is_fpm_running; then
        echo "PHP-FPM ya esta corriendo."
        return 0
    fi

    if [ -S "$FPM_SOCK" ]; then
        echo "Limpiando socket huerfano de PHP-FPM..."
        rm -f "$FPM_SOCK"
    fi

    echo "Iniciando PHP-FPM..."
    php-fpm
    sleep 1

    if is_fpm_running; then
        echo "PHP-FPM iniciado correctamente."
    else
        echo -e "${YELLOW}Aviso: PHP-FPM no pudo iniciarse. Revisa $PREFIX/var/log/php-fpm.log${NC}"
    fi
}

stop_fpm() {
    if is_fpm_running; then
        echo "Deteniendo PHP-FPM..."
        pkill -f "php-fpm"
        sleep 1
        rm -f "$FPM_SOCK"
    fi
}

# ================================================================
# MariaDB
# ================================================================
start_mariadb() {
    if is_mariadb_running; then
        echo "MariaDB ya esta corriendo."
        return 0
    fi

    echo "Iniciando MySQL/MariaDB..."
    mariadbd-safe &
    sleep 3
}

stop_mariadb() {
    if is_mariadb_safe_running; then
        echo "Deteniendo mariadbd-safe..."
        pkill -f "mariadbd-safe"
        sleep 1
    fi

    if is_mariadb_running; then
        echo "Deteniendo mariadbd..."
        pkill -f "bin/mariadbd"
        sleep 2
    fi

    if is_mariadb_running; then
        echo "Forzando cierre de mariadbd..."
        pkill -9 -f "bin/mariadbd"
        sleep 1
    fi
}

# ================================================================
# Apache
# ================================================================
start_apache() {
    if is_apache_running; then
        echo "Apache ya esta corriendo."
        return 0
    fi

    echo "Iniciando Apache..."
    apachectl start
    sleep 1
}

stop_apache() {
    if is_apache_running; then
        echo "Deteniendo Apache..."
        apachectl stop
        sleep 2

        for i in 1 2 3 4 5; do
            is_apache_running || break
            sleep 1
        done

        if is_apache_running; then
            echo "Forzando cierre de Apache..."
            pkill -f "bin/httpd"
            sleep 1
        fi
    fi
}

# ================================================================
# Comandos
# ================================================================
case $ACMD in
start)
    ensure_mysql_socket_config
    add_virtualhost_life
    generate_apache_vhosts

    start_apache
    start_fpm
    start_mariadb

    echo "Abriendo navegador: http://localhost/"
    termux-open-url http://localhost/
    ;;

start-ssl)
    if ! openssl x509 -checkend 86400 -noout -in /data/data/com.termux/files/usr/etc/apache2/server.crt
    then
        echo "El certificado SSL ha expirado."
        echo "Creando un nuevo certificado SSL..."

        cd ~/
        openssl req -x509 -newkey rsa:2048 \
            -keyout server.key \
            -out server.crt \
            -days 365 \
            -nodes \
            -subj '/CN=localhost' \
            -addext "subjectAltName=DNS:localhost,DNS:*.go,IP:127.0.0.1"

        mv -f server.crt $PREFIX/etc/apache2/server.crt
        mv -f server.key $PREFIX/etc/apache2/server.key
    fi

    ensure_mysql_socket_config
    add_virtualhost_life
    generate_apache_vhosts

    echo "Iniciando Matrix Server con SSL..."
    apachectl restart
    sleep 1

    fix_fpm_config

    if ! is_fpm_running; then
        php-fpm
        sleep 1
    fi

    start_mariadb

    echo "Abriendo navegador: https://localhost/"
    termux-open-url https://localhost/
    ;;

stop)
    echo "Deteniendo Matrix Server..."

    stop_fpm
    stop_apache
    stop_mariadb

    rm -f "$FPM_SOCK" 2>/dev/null

    echo ""
    REMAIN=0

    if is_fpm_running; then
        echo -e "${YELLOW}Aviso: PHP-FPM sigue corriendo.${NC}"
        REMAIN=1
    fi

    if is_apache_running; then
        echo -e "${YELLOW}Aviso: Apache sigue corriendo.${NC}"
        REMAIN=1
    fi

    if is_mariadb_running; then
        echo -e "${YELLOW}Aviso: MariaDB sigue corriendo.${NC}"
        REMAIN=1
    fi

    if [ "$REMAIN" = "0" ]; then
        echo -e "${GREEN}Matrix Server detenido correctamente.${NC}"
    else
        echo -e "${RED}Algunos servicios no se detuvieron.${NC}"
    fi
    ;;

restart)
    echo -e "${BLUE}Reiniciando Matrix Server...${NC}"
    echo ""

    echo "=== Deteniendo servicios ==="
    stop_fpm
    stop_apache
    stop_mariadb

    rm -f "$FPM_SOCK" 2>/dev/null

    sleep 1

    echo ""
    echo "=== Iniciando servicios ==="

    ensure_mysql_socket_config
    add_virtualhost_life
    generate_apache_vhosts

    start_apache
    start_fpm
    start_mariadb

    echo ""
    echo -e "${GREEN}Matrix Server reiniciado correctamente.${NC}"
    echo "Abriendo navegador: http://localhost/"
    termux-open-url http://localhost/
    ;;

vhosts)
    echo -e "${BLUE}=== Dominios virtuales ===${NC}"
    echo ""

    if [ ! -f "$VHOST_LIFE_FILE" ]; then
        echo -e "${YELLOW}No existe $VHOST_LIFE_FILE${NC}"
        echo "Ejecuta 'matrix start' para generarlo."
        exit 0
    fi

    echo "Archivo de hosts: $VHOST_LIFE_FILE"
    echo "Contenido:"
    cat "$VHOST_LIFE_FILE"
    echo ""

    if [ ! -d "$VHOST_DIR" ]; then
        echo -e "${YELLOW}No hay VirtualHosts generados.${NC}"
        echo "Ejecuta 'matrix start' para generarlos."
        exit 0
    fi

    echo "VirtualHosts en Apache: $VHOST_DIR"
    echo ""

    FOUND=0
    for conf in "$VHOST_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        SERVER_NAME=$(grep -m1 'ServerName' "$conf" | awk '{print $2}')
        DOC_ROOT=$(grep -m1 'DocumentRoot' "$conf" | awk -F'"' '{print $2}')
        echo "  $SERVER_NAME"
        echo "    -> $DOC_ROOT"
        FOUND=$((FOUND + 1))
    done

    if [ "$FOUND" = "0" ]; then
        echo "  (ninguno)"
    else
        echo ""
        echo -e "${GREEN}Total: $FOUND dominios${NC}"
    fi

    echo ""
    echo -e "${YELLOW}Recuerda:${NC} la app Virtual Hosts debe estar activa"
    echo "para que *.go resuelva a 127.0.0.1"
    ;;

status)
    echo -e "${BLUE}=== Estado de Matrix Server ===${NC}"
    echo ""

    if is_apache_running; then
        echo -e "Apache:      ${GREEN}ACTIVO${NC}"
    else
        echo -e "Apache:      ${RED}APAGADO${NC}"
    fi

    if is_fpm_running; then
        FPM_COUNT=$(pgrep -f "php-fpm" | wc -l)
        echo -e "PHP-FPM:     ${GREEN}ACTIVO${NC} ($FPM_COUNT procesos)"
    else
        echo -e "PHP-FPM:     ${RED}APAGADO${NC}"
    fi

    if is_mariadb_running; then
        echo -e "MariaDB:     ${GREEN}ACTIVO${NC}"
    else
        echo -e "MariaDB:     ${RED}APAGADO${NC}"
    fi

    echo ""

    echo -e "${BLUE}Puertos:${NC}"

    if command -v ss > /dev/null 2>&1; then
        P80=$(ss -tln 2>/dev/null | grep -c ':80 ')
        P443=$(ss -tln 2>/dev/null | grep -c ':443 ')
        P3306=$(ss -tln 2>/dev/null | grep -c ':3306 ')

        if [ "$P80" -gt 0 ]; then
            echo -e " Puerto 80:   ${GREEN}ESCUCHANDO${NC}"
        else
            echo -e " Puerto 80:   ${RED}NO ESCUCHA${NC}"
        fi

        if [ "$P443" -gt 0 ]; then
            echo -e " Puerto 443:  ${GREEN}ESCUCHANDO${NC}"
        else
            echo -e " Puerto 443:  ${RED}NO ESCUCHA${NC}"
        fi

        if [ "$P3306" -gt 0 ]; then
            echo -e " Puerto 3306: ${GREEN}ESCUCHANDO${NC}"
        else
            echo -e " Puerto 3306: ${RED}NO ESCUCHA${NC}"
        fi
    else
        echo " (comando ss no disponible)"
    fi

    echo ""

    echo -e "${BLUE}Sockets:${NC}"

    if [ -S "$FPM_SOCK" ]; then
        echo -e " PHP-FPM:     ${GREEN}$FPM_SOCK${NC}"
    else
        echo -e " PHP-FPM:     ${RED}no existe${NC}"
    fi

    MYSQL_SOCK=$(detect_mysql_socket)
    if [ -n "$MYSQL_SOCK" ] && [ -S "$MYSQL_SOCK" ]; then
        echo -e " MariaDB:     ${GREEN}$MYSQL_SOCK${NC}"
    else
        echo -e " MariaDB:     ${RED}no detectado${NC}"
    fi

    echo ""

    echo -e "${BLUE}Acceso:${NC}"
    echo " HTTP:        http://localhost/"
    echo " HTTPS:       https://localhost/"
    echo " phpMyAdmin:  http://localhost/phpmyadmin"
    echo " htdocs:      /sdcard/htdocs"

    if [ -d "$VHOST_DIR" ]; then
        VCOUNT=$(ls -1 "$VHOST_DIR"/*.conf 2>/dev/null | wc -l)
        if [ "$VCOUNT" -gt 0 ]; then
            echo ""
            echo -e "${BLUE}Dominios .go activos:${NC} $VCOUNT"
            echo "  Ejecuta 'matrix vhosts' para verlos"
        fi
    fi
    ;;

update)
    if [ ! -d ~/matrix ]; then
        echo "No se encontro el directorio de Matrix."
        echo "Clonando Matrix Server..."

        git clone https://github.com/Franklin-Soft/Matrix-Server.git ~/matrix
    fi

    cd $HOME/matrix

    git remote update

    STATUS=$(git status -uno | grep 'Your branch is up to date')

    echo "Buscando actualizaciones de Matrix Server..."

    if [ -z "$STATUS" ]; then
        git reset --hard HEAD
        git pull

        sh update
    else
        echo -e "${YELLOW}Matrix Server ya esta actualizado.${NC}"
    fi
    ;;

uninstall)
    echo "Estas completamente seguro?"
    echo ""
    echo "Esta accion eliminara permanentemente todos los datos del servidor web (Apache, MySQL/MariaDB, PHP, Composer) y no se puede deshacer."
    echo ""

    read -p "Deseas continuar? (y/n) " REPLY

    if [ "$REPLY" = "y" ]; then
        echo "Deteniendo todos los servicios antes de desinstalar..."
        stop_fpm
        stop_apache
        stop_mariadb

        rm -f $PREFIX/etc/apache2/server.crt
        rm -f $PREFIX/etc/apache2/server.key

        apt purge apache2 php php-fpm php-sodium php-apache openssl-tool mariadb -y
        apt autoremove -y

        cd ~/
        rm -rf matrix
        rm -f $PREFIX/bin/matrix

        echo "Matrix Server se ha desinstalado correctamente."
    else
        echo "Cancelado."
    fi
    ;;

*)
    echo "Matrix Server (Termux, Apache, MariaDB, PHP) v1.0"
    echo "por github.com/Franklin-Soft"
    echo ""
    echo "Comandos:"
    echo " start          Iniciar Matrix Server en el puerto 80"
    echo " start-ssl      Iniciar Matrix Server con SSL en el puerto 443"
    echo " stop           Detener Matrix Server"
    echo " restart        Reiniciar Matrix Server"
    echo " status         Ver el estado de los servicios"
    echo " vhosts         Ver los dominios .go activos"
    echo " update         Actualizar Matrix Server"
    echo " uninstall      Desinstalar Matrix Server"
    ;;
esac

# matrix
